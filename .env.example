# ==========================================
# Last-Mile Delivery Tracker - Environment Configuration
# ==========================================

# Port configuration (for local or containerized execution)
PORT=3000
NODE_ENV=production

# App Hosting & Domain URL (optional for Vercel, defaults to auto-assigned domain)
VITE_APP_URL="https://your-project.vercel.app"

# Optional 3rd-Party Integrations (Email/SMS Notification Services)
# VITE_SENDGRID_API_KEY=""
# VITE_TWILIO_AUTH_TOKEN=""
# VITE_TWILIO_ACCOUNT_SID=""

# Gemini AI (if server-side AI dispatch features are enabled)
GEMINI_API_KEY=""

